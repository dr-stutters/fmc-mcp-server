# Shared-host settings for examples/shared-host (docs/deploying.md). Copy to .env, chmod 600, never commit it.

# Image: pin a version on a shared host (latest / rc also exist)
MCP_IMAGE_TAG=latest

# TLS (Caddy): the name clients use, and "internal" or your ACME e-mail address
MCP_HOSTNAME=mcp-fmc.example.com
CADDY_TLS=internal

# The default FMC and this server's own FMC API user (docs/least-privilege.md). One FMC user per server
# instance: FMC ends a user's other sessions on every login, so never reuse the GUI admin or another
# integration's user.
FMC_URL=https://fmc.example.com
FMC_USERNAME=mcp-api-ro
FMC_PASSWORD=
# FMC_PASSWORD_FILE=/run/secrets/fmc_password   # preferred: a Docker secret instead of a value here
# FMC_CA_BUNDLE=/certs/fmc-ca.pem
# FMC_DOMAIN=Global
# FMC allows 120 requests/min per FMC, shared with every other API user of that FMC; this server's limiter
# is shared by all its callers (default 110).
# FMC_RATE_LIMIT=110

# More FMCs (optional): each has its own URL, API user and TLS settings
# FMC_INSTANCES=dr
# FMC_DR_URL=https://fmc-dr.example.com
# FMC_DR_USERNAME=mcp-api-ro
# FMC_DR_PASSWORD=
# FMC_DR_READ_ONLY=true

# One token per person: fmc-mcp-server token <name>, then paste the name:sha256:<hex> lines here
MCP_AUTH_TOKENS=

# Read-only unless you opt in. With writes on, MCP_ROLES decides who may use them (ro / rw / admin).
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_ROLES=alice:rw,bob:ro

# Regulated sites (FMC 7.6+ change management): send a ticket id with every request (docs/deploying.md)
# FMC_TICKET=
