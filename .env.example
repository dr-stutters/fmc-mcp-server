# Copy to .env (git-ignored, chmod 600) and fill in.

# --- FMC connection ---------------------------------------------------------------------------
FMC_URL=https://fmc.example.com
# The server's own FMC user with a custom role (docs/least-privilege.md); never admin.
FMC_USERNAME=
FMC_PASSWORD=
# Optional: the hosted container's user (docker-compose.yml; write a '$' in a password as '$$' for compose), so it never shares a session with the CLI.
FMC_SVC_USERNAME=
FMC_SVC_PASSWORD=
# Optional: a read-only user (role mcp-ro) for tests/live/test_least_privilege.py.
FMC_RO_USERNAME=
FMC_RO_PASSWORD=
# Optional FMC web-UI user for fmc_test_realm / fmc_download_realm (FMC's REST API can't test or download
# an AD/LDAP realm). Its own user (role with Integrations > Realms modify), never FMC_USERNAME.
FMC_UI_USERNAME=
FMC_UI_PASSWORD=
# Lab seed scripts (not in this repo) read an FMC administrator from .env.admin: FMC_ADMIN_USERNAME / FMC_ADMIN_PASSWORD.
# Verify the FMC's TLS certificate (set false only for labs with self-signed certificates),
# or point FMC_CA_BUNDLE at the CA that issued it.
FMC_VERIFY_SSL=true
FMC_CA_BUNDLE=
# Default domain (name such as Global or Global/Child, or UUID). Empty = the login's domain.
FMC_DOMAIN=
# FMC allows ~120 requests/min and 10 concurrent connections per source IP.
FMC_RATE_LIMIT=110
FMC_MAX_CONCURRENCY=8
FMC_TIMEOUT=30
FMC_RETRIES=2
# Deploy safety rails (README "Deploy safety rails"): a maintenance window for deploy/rollback/register/
# HA changes (MCP_CHANGE_WINDOW syntax), and whether fmc_deploy may ignore FMC validation warnings.
FMC_DEPLOY_WINDOW=
FMC_ALLOW_IGNORE_WARNING=false
# Dynamic object fmc_contain_host / fmc_release_host use (created on first use).
FMC_QUARANTINE_OBJECT=mcp-quarantine

# --- MCP server -------------------------------------------------------------------------------
# stdio (default) or http
MCP_TRANSPORT=stdio
MCP_PORT=8000
# Required for HTTP: name:sha256:<hex> entries from `fmc-mcp-server token <name>`
MCP_AUTH_TOKENS=
# Write tools (preview-first) and the dangerous tier (deploys, device/HA changes, policy deletes)
MCP_ENABLE_WRITES=false
MCP_ENABLE_DANGEROUS=false
LOG_LEVEL=INFO

# --- Live tests (optional) --------------------------------------------------------------------
# Inputs for tests/live that depend on your FMC/FTD (docs/live-tests.md). Unset = the tests that need them
# are skipped. Example values only; the CML recipe ftd-fmc in cml-mcp-server builds a matching FTD.
# The managed FTD (onboard, configure, deploy, troubleshoot, rollback; needed by most write tests):
# FMC_LIVE_DEVICE=ftd1
# FMC_LIVE_FTD_HOST=192.0.2.151
# FMC_LIVE_FTD_REG_KEY=
# FMC_LIVE_FTD_OUTSIDE_IP=192.0.2.155/24
# FMC_LIVE_FTD_GATEWAY=192.0.2.1
# FMC_LIVE_TRACE_TARGET=198.51.100.10
# Optional extras:
# FMC_LIVE_PING_TARGET=192.0.2.1
# FMC_LIVE_NTP_SERVER=192.0.2.1
# FMC_LIVE_FTD_NO_ARP_IP=192.0.2.199
# FMC_LIVE_FTD_REREGISTER=1
# FMC_LIVE_NO_PEER=1
# Multi-domain and identity tests:
# FMC_LIVE_LEAF_DOMAIN=Global/mcp-test-leaf
# FMC_LIVE_REALM=mcp-test-ad
# FMC_LIVE_REALM_GROUP=mcp-contractors
# FMC_LIVE_IDENTITY_POLICY=mcp-test-idp
